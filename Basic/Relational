import java.util.Scanner;

class Relational {
    public static void main(String[] args) {
        Scanner obj = new Scanner (System.in);
        int a = obj.nextInt();
        int b = obj.nextInt();

        System.out.println("true/false: " +(a<b));
        
        System.out.println("true/false: " +(a>b));
        
        System.out.println("true/false: " +(a<=b));
        
        System.out.println("true/false: " +(a>=b));
        
        System.out.println("true/false: " +(a==b));
        
        System.out.println("true/false: " +(a!=b));
        
        
        
        
        
        
    }
}
