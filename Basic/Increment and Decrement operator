class prepost{
    public static void main(String[]args){
        int a =10;
        System.out.println("Increment ");
        System.out.println(a++);
        System.out.println(++a);

        System.out.println("Decrement ");
        System.out.println(a--);
        System.out.println(--a);
        
    }
    
}
