// Static → Remains even after the method ends.**
// Local → Ends when the method ends.**


class A{

  static int a = 50;

  void fun()
  {
    int b = 60;
    a++;
    b++;
    System.out.println(a+" "+b);
  }
  public static void main (String []args){
    A ref = new A();
    ref.fun ();
    ref.fun ();

    
  }

}
